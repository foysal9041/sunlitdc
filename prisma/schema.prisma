generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  NOC
}

enum PopStatus {
  ACTIVE
  DISABLED
}

enum AvailabilityStatus {
  NEW
  CONTACTED
  CONFIRMED
  DECLINED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
}

model PointOfPresence {
  id          String    @id @default(cuid())
  district    String
  generalArea String
  status      PopStatus @default(ACTIVE)

  // Internal / sensitive fields — admin-only, never returned by the public API.
  name                 String?
  btrcPopId            String?
  exactAddress         String?
  latitude             Float?
  longitude            Float?
  nttnProvider         String?
  linkId               String?
  vlan                 String?
  ipAddress            String?
  oltInfo              String?
  routerSwitchInfo     String?
  internalCapacityMbps Int?
  topologyNotes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([district])
  @@index([status])
}

// Submissions from the public "Check Availability" form on the Coverage
// page — a lead queue for the sales/NOC team, reviewed from the admin panel.
model AvailabilityRequest {
  id        String             @id @default(cuid())
  district  String
  area      String
  phone     String?
  status    AvailabilityStatus @default(NEW)
  createdAt DateTime           @default(now())

  @@index([status])
  @@index([createdAt])
}
