# Base URL of the ISP billing/CRM/auth backend API.
# Leave empty during local development — API calls fail gracefully
# with a clear message until a real backend is connected.
NEXT_PUBLIC_API_URL=

# --- Coverage / Admin database ---
# SQLite by default; point at Postgres/MySQL later by changing this URL
# and the `provider` in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Secret used to sign admin session cookies (JWT/HS256). Generate a real
# random value for any non-local environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me"

# Seeded on first `npm run db:seed` — sign in at /admin/login with these,
# then change the password (or add a real admin user) before going live.
ADMIN_SEED_EMAIL="admin@sunlitnetwork.com"
ADMIN_SEED_PASSWORD="change-me"
